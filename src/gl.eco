public function supports(const string& $name) : bool
{
    int32 $n = __getInt(state::$commands->GetIntegerv, __NUM_EXTENSIONS);
    return __extSupported(state::$commands->GetStringi, $n, $name);
}

public function versionMajor() : int32
{
    return __getInt(state::$commands->GetIntegerv, __MAJOR_VERSION);
}

public function versionMinor() : int32
{
    return __getInt(state::$commands->GetIntegerv, __MINOR_VERSION);
}

